# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit real credentials/API keys
.env

# Runtime output from the RPA bot control panel (saved console logs) — not source
rpa-bot/log_rpa_bot/

# Python bytecode cache
__pycache__/
*.pyc

# RPA bot single-instance lock file (runtime state, not source — see main.py)
rpa-bot/.bot.lock

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# RPA bot .exe build output (large, regenerated by rpa-bot/build_exe.py)
rpa-bot/build_assets/
rpa-bot/build_work/
rpa-bot/dist/
